{
  "$schema": "https://opencode.ai/config.json",
  "compaction": { "auto": true },
  "policies": [
    { "action": "mcp.use", "resource": "*", "effect": "deny" },
    { "action": "mcp.use", "resource": "context7", "effect": "allow" }
  ],
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "*.env*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "cargo *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "opencode.json*", "effect": "deny" },
    { "action": "edit", "resource": "scripts/*", "effect": "deny" },
    { "action": "edit", "resource": ".rustday/*", "effect": "deny" },
    { "action": "edit", "resource": ".boardcraft/*", "effect": "deny" }
  ]
}
